@using bandothanhli.Areas.Admin.Models
@model DangNhapVM
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .box {
            background: #fff;
            border-radius: 16px;
            padding: 40px 36px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 25px 60px rgba(0,0,0,.35);
        }
        .form-control {
            border-radius: 8px;
            padding: 10px 14px;
            border: 1.5px solid #e2e8f0;
            font-size: .9rem;
        }
        .form-control:focus {
            border-color: #f97316;
            box-shadow: 0 0 0 3px rgba(249,115,22,.15);
        }
        .form-control.is-invalid {
            border-color: #ef4444;
            box-shadow: none;
        }
        .btn-login {
            background: #f97316;
            border: none;
            border-radius: 8px;
            padding: 12px;
            font-weight: 600;
            width: 100%;
            color: #fff;
            font-size: .95rem;
            transition: background .2s;
        }
        .btn-login:hover { background: #ea6c0a; }
        .alert-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 10px;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #dc2626;
            font-size: .875rem;
            margin-bottom: 20px;
        }
        .alert-error i { font-size: 1.1rem; flex-shrink: 0; }
    </style>
</head>
<body>
<div class="box">

    <div class="text-center mb-4">
        <div style="font-size:2.2rem;color:#f97316">
            <i class="bi bi-recycle"></i>
        </div>
        <h5 class="fw-bold mt-2 mb-0">Quản trị hệ thống</h5>
        <p class="text-muted small mt-1">Thanh Lý Đồ Cũ</p>
    </div>

    @*
        Chỉ hiện lỗi chung (key = "") — tức là lỗi từ controller
        Không hiện lỗi validation của từng field ở đây
    *@
    @if (ViewData.ModelState.ContainsKey("") &&
         ViewData.ModelState[""]!.Errors.Count > 0)
    {
        <div class="alert-error">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@ViewData.ModelState[""]!.Errors[0].ErrorMessage</span>
        </div>
    }

    <form asp-area="Admin" asp-controller="Auth" asp-action="DangNhap" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">Email</label>
            <div class="input-group">
                <span class="input-group-text bg-light">
                    <i class="bi bi-envelope text-secondary"></i>
                </span>
                <input asp-for="Email"
                       class="form-control"
                       placeholder="admin@example.com"
                       autocomplete="email" />
            </div>
            @* Lỗi validation hiện nhỏ dưới ô *@
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label class="form-label small fw-semibold text-secondary">Mật khẩu</label>
            <div class="input-group">
                <span class="input-group-text bg-light">
                    <i class="bi bi-lock text-secondary"></i>
                </span>
                <input asp-for="MatKhau"
                       class="form-control"
                       placeholder="••••••••"
                       autocomplete="current-password"
                       id="matKhauInput" />
                <button type="button"
                        class="input-group-text bg-light"
                        onclick="toggleMatKhau()"
                        style="cursor:pointer;border-left:none">
                    <i class="bi bi-eye text-secondary" id="eyeIcon"></i>
                </button>
            </div>
            <span asp-validation-for="MatKhau" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn-login">
            <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
        </button>
    </form>

</div>
<script>
    function toggleMatKhau() {
        const input = document.getElementById('matKhauInput');
        const icon  = document.getElementById('eyeIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash text-secondary';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye text-secondary';
        }
    }
</script>
</body>
</html>