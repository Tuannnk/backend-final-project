@using bandothanhli.Areas.Admin.Models
@model DoiMatKhauVM
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-key me-2 text-warning"></i>Đổi mật khẩu
            </div>
            <div class="card-body p-4">
                <form asp-area="Admin" asp-controller="Auth" asp-action="DoiMatKhau" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mật khẩu cũ</label>
                        <input asp-for="MatKhauCu" class="form-control" />
                        <span asp-validation-for="MatKhauCu" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mật khẩu mới</label>
                        <input asp-for="MatKhauMoi" class="form-control" />
                        <span asp-validation-for="MatKhauMoi" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-semibold">Xác nhận mật khẩu</label>
                        <input asp-for="XacNhan" class="form-control" />
                        <span asp-validation-for="XacNhan" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-warning w-100 fw-semibold">
                        <i class="bi bi-check-lg me-1"></i>Cập nhật mật khẩu
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>