@using bandothanhli.Areas.Admin.Models
@model List<DanhMucVM>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Danh mục";
}

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Them" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Thêm danh mục
    </a>
</div>
<div class="card">
    <div class="card-header">
        <i class="bi bi-tags me-2"></i>Danh sách danh mục (@Model.Count)
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-3">Tên danh mục</th>
                    <th>Danh mục cha</th>
                    <th>Slug</th>
                    <th class="text-center">Thứ tự</th>
                    <th class="text-center">Số SP</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td class="ps-3">
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(d.IconUrl))
                                {
                                    <img src="@d.IconUrl"
                                         style="width:22px;height:22px;object-fit:cover" />
                                }
                                <span class="fw-semibold small">@d.TenDanhMuc</span>
                            </div>
                        </td>
                        <td class="small text-muted">@(d.TenDanhMucCha ?? "— Gốc —")</td>
                        <td><code class="small">@d.Slug</code></td>
                        <td class="text-center small">@d.ThuTu</td>
                        <td class="text-center">
                            <span class="badge bg-light text-dark">@d.SoSanPham</span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Sua" asp-route-id="@d.Id"
                                   class="btn btn-sm btn-light btn-action me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Xoa" asp-route-id="@d.Id"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Xóa danh mục @d.TenDanhMuc?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-danger btn-action">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>Chưa có danh mục
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>