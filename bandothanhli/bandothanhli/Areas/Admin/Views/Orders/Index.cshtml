@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="adm-panel">
    <div class="d-flex flex-column flex-md-row gap-2 justify-content-between align-items-md-center mb-2">
        <div class="d-flex align-items-center gap-2">
            <div class="adm-panel-title">Danh sách đơn hàng</div>
            <button class="btn btn-sm btn-outline-secondary" type="button" id="admOrdersRefreshBtn">Tải lại</button>
        </div>
        <div class="d-flex align-items-center gap-2">
            <select class="form-select form-select-sm" id="admOrdersStatus" style="max-width: 200px;">
                <option value="">Tất cả trạng thái</option>
                <option value="cho_xac_nhan">Chờ xác nhận</option>
                <option value="dang_giao">Đang giao</option>
                <option value="da_giao">Đã giao</option>
                <option value="hoan_thanh">Hoàn thành</option>
                <option value="da_huy">Đã hủy</option>
            </select>
            <select class="form-select form-select-sm" id="admOrdersPageSize" style="max-width: 120px;">
                <option value="10">10 / trang</option>
                <option value="20">20 / trang</option>
                <option value="50">50 / trang</option>
            </select>
        </div>
    </div>

    <div class="alert alert-warning d-none" id="admOrdersError"></div>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Người mua</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Tổng tiền</th>
                    <th>Ngày tạo</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody id="admOrdersBody"></tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-2">
        <div class="text-muted small" id="admOrdersMeta"></div>
        <nav aria-label="Pagination">
            <ul class="pagination pagination-sm mb-0" id="admOrdersPagination"></ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script>
        window.__ADMIN_PAGE__ = "orders";
    </script>
}
