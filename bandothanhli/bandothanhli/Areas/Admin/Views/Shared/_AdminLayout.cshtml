@using bandothanhli.Areas.Admin.Models
@using bandothanhli.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Quản trị</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --sidebar-w: 240px;
            --topbar-h:  56px;
            --primary:   #f97316;
            --dark:      #1e293b;
            --darker:    #0f172a;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #f1f5f9;
            font-family: 'Segoe UI', sans-serif;
            font-size: .9rem;
            color: #334155;
        }

        /* ════════════════════════
           SIDEBAR
        ════════════════════════ */
        .sidebar {
            position: fixed;
            top: 0; left: 0;
            width: var(--sidebar-w);
            height: 100vh;
            background: var(--dark);
            display: flex;
            flex-direction: column;
            z-index: 300;
            transition: transform .25s ease;
            overflow: hidden;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 18px 20px;
            font-size: 1.05rem;
            font-weight: 700;
            color: #f8fafc;
            border-bottom: 1px solid #334155;
            text-decoration: none;
            flex-shrink: 0;
        }
        .sidebar-brand span { color: var(--primary); }
        .sidebar-brand i { font-size: 1.3rem; color: var(--primary); }

        .sidebar-nav {
            flex: 1;
            overflow-y: auto;
            padding: 8px 0 16px;
            scrollbar-width: thin;
            scrollbar-color: #334155 transparent;
        }
        .sidebar-nav::-webkit-scrollbar { width: 4px; }
        .sidebar-nav::-webkit-scrollbar-thumb { background: #334155; border-radius: 2px; }

        .nav-section {
            font-size: .68rem;
            text-transform: uppercase;
            color: #475569;
            padding: 16px 20px 5px;
            letter-spacing: 1px;
            font-weight: 600;
        }

        .nav-item { display: block; }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 20px;
            color: #94a3b8;
            text-decoration: none;
            transition: all .15s;
            border-left: 3px solid transparent;
            white-space: nowrap;
        }
        .nav-link i {
            font-size: 1rem;
            width: 18px;
            text-align: center;
            flex-shrink: 0;
        }
        .nav-link:hover {
            color: #f8fafc;
            background: #334155;
        }
        .nav-link.active {
            color: #fff;
            background: #334155;
            border-left-color: var(--primary);
        }
        .nav-link .badge {
            margin-left: auto;
            font-size: .65rem;
            padding: 2px 6px;
        }

        .sidebar-footer {
            padding: 10px;
            border-top: 1px solid #334155;
            flex-shrink: 0;
        }
        .sidebar-footer .nav-link {
            border-radius: 6px;
            border-left: none;
        }
        .sidebar-footer .nav-link:hover { background: #334155; }
        .sidebar-footer .btn-logout {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 20px;
            color: #94a3b8;
            background: none;
            border: none;
            border-radius: 6px;
            width: 100%;
            text-align: left;
            cursor: pointer;
            transition: all .15s;
            font-size: .9rem;
        }
        .sidebar-footer .btn-logout:hover {
            color: #fca5a5;
            background: #334155;
        }
        .sidebar-footer .btn-logout i { width: 18px; text-align: center; }

        /* ════════════════════════
           TOPBAR
        ════════════════════════ */
        .topbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-w);
            right: 0;
            height: var(--topbar-h);
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            z-index: 200;
            transition: left .25s ease;
        }

        .topbar-left { display: flex; align-items: center; gap: 12px; }
        .topbar-title { font-weight: 600; color: var(--dark); font-size: .95rem; }

        .topbar-right { display: flex; align-items: center; gap: 16px; }

        .topbar-avatar {
            width: 34px; height: 34px;
            background: #e2e8f0;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #64748b;
            font-size: 1rem;
        }

        .btn-sidebar-toggle {
            background: none;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 5px 9px;
            color: #64748b;
            cursor: pointer;
            display: none;
            transition: all .15s;
        }
        .btn-sidebar-toggle:hover { background: #f8fafc; color: var(--dark); }

        /* ════════════════════════
           MAIN CONTENT
        ════════════════════════ */
        .main-wrap {
            margin-left: var(--sidebar-w);
            padding-top: var(--topbar-h);
            min-height: 100vh;
            transition: margin-left .25s ease;
        }

        .content { padding: 24px; }

        /* ════════════════════════
           CARD
        ════════════════════════ */
        .card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: none;
        }
        .card-header {
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            padding: 14px 20px;
            font-weight: 600;
            font-size: .9rem;
            border-radius: 12px 12px 0 0 !important;
            display: flex;
            align-items: center;
        }
        .card-footer {
            background: #fff;
            border-top: 1px solid #e2e8f0;
            padding: 12px 20px;
            border-radius: 0 0 12px 12px !important;
        }

        /* ════════════════════════
           STAT CARD
        ════════════════════════ */
        .stat-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 20px;
            transition: box-shadow .2s, transform .2s;
        }
        .stat-card:hover {
            box-shadow: 0 4px 20px rgba(0,0,0,.08);
            transform: translateY(-1px);
        }
        .stat-icon {
            width: 46px; height: 46px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }
        .stat-value {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--dark);
            line-height: 1.2;
        }
        .stat-label {
            color: #64748b;
            font-size: .8rem;
            margin-top: 3px;
        }

        /* ════════════════════════
           TABLE
        ════════════════════════ */
        .table th {
            font-size: .73rem;
            text-transform: uppercase;
            color: #64748b;
            font-weight: 600;
            border-bottom: 2px solid #e2e8f0;
            padding: 10px 12px;
            white-space: nowrap;
        }
        .table td {
            vertical-align: middle;
            padding: 10px 12px;
            color: #334155;
            border-color: #f1f5f9;
        }
        .table-hover tbody tr:hover { background: #f8fafc; }

        /* ════════════════════════
           BADGE TRẠNG THÁI
        ════════════════════════ */
        .badge-tt {
            padding: 3px 10px;
            border-radius: 20px;
            font-size: .74rem;
            font-weight: 600;
            display: inline-block;
            white-space: nowrap;
        }
        .tt-DangBan       { background: #dcfce7; color: #16a34a; }
        .tt-DaBan         { background: #f1f5f9; color: #475569; }
        .tt-AnHang        { background: #fef9c3; color: #92400e; }
        .tt-ChoPhanHoi    { background: #fef3c7; color: #b45309; }
        .tt-DaXacNhan     { background: #dbeafe; color: #1d4ed8; }
        .tt-DangGiao      { background: #ede9fe; color: #6d28d9; }
        .tt-DaGiao        { background: #dcfce7; color: #16a34a; }
        .tt-HuyDon        { background: #fee2e2; color: #dc2626; }
        .tt-DaThanhToan   { background: #dcfce7; color: #16a34a; }
        .tt-ChuaThanhToan { background: #fee2e2; color: #dc2626; }

        /* ════════════════════════
           MISC
        ════════════════════════ */
        .btn-action { padding: 4px 10px; font-size: .8rem; border-radius: 6px; }

        .alert { border: none; border-radius: 10px; }

        .form-control, .form-select {
            border-color: #e2e8f0;
            border-radius: 8px;
            font-size: .875rem;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(249,115,22,.15);
        }

        .btn { border-radius: 8px; font-size: .875rem; }
        .btn-primary { background: var(--primary); border-color: var(--primary); }
        .btn-primary:hover { background: #ea6c0a; border-color: #ea6c0a; }

        .pagination .page-link {
            border-radius: 6px !important;
            margin: 0 2px;
            border-color: #e2e8f0;
            color: #475569;
            font-size: .82rem;
        }
        .pagination .page-item.active .page-link {
            background: var(--primary);
            border-color: var(--primary);
        }

        /* ════════════════════════
           OVERLAY MOBILE
        ════════════════════════ */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.45);
            z-index: 299;
            backdrop-filter: blur(2px);
        }
        .sidebar-overlay.open { display: block; }

        /* ════════════════════════
           RESPONSIVE
        ════════════════════════ */
        @@media (max-width: 768px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.open { transform: translateX(0); }
            .topbar { left: 0; }
            .main-wrap { margin-left: 0; }
            .btn-sidebar-toggle { display: flex; align-items: center; }
            .content { padding: 16px; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<!-- Overlay mobile -->
<div class="sidebar-overlay" id="overlay" onclick="closeSidebar()"></div>

<!-- ════════ SIDEBAR ════════ -->
<aside class="sidebar" id="sidebar">

    <a class="sidebar-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
        <i class="bi bi-recycle"></i>
        <span>Thanh Lý</span> Đồ Cũ
    </a>

    <nav class="sidebar-nav">

        <div class="nav-section">Tổng quan</div>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
           asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
        </a>

        <div class="nav-section">Quản lý</div>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "NguoiDung" ? "active" : "")"
           asp-area="Admin" asp-controller="NguoiDung" asp-action="Index">
            <i class="bi bi-people"></i>
            <span>Người dùng</span>
        </a>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SanPham" ? "active" : "")"
           asp-area="Admin" asp-controller="SanPham" asp-action="Index">
            <i class="bi bi-box-seam"></i>
            <span>Sản phẩm</span>
        </a>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DonHang" ? "active" : "")"
           asp-area="Admin" asp-controller="DonHang" asp-action="Index">
            <i class="bi bi-cart3"></i>
            <span>Đơn hàng</span>
        </a>

        <div class="nav-section">Danh mục</div>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DanhMuc" ? "active" : "")"
           asp-area="Admin" asp-controller="DanhMuc" asp-action="Index">
            <i class="bi bi-tags"></i>
            <span>Danh mục</span>
        </a>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TinhTrang" ? "active" : "")"
           asp-area="Admin" asp-controller="TinhTrang" asp-action="Index">
            <i class="bi bi-stars"></i>
            <span>Tình trạng SP</span>
        </a>

    </nav>

    <div class="sidebar-footer">
        <a class="nav-link" asp-area="Admin" asp-controller="Auth" asp-action="DoiMatKhau">
            <i class="bi bi-key"></i>
            <span>Đổi mật khẩu</span>
        </a>
        <form asp-area="Admin" asp-controller="Auth" asp-action="DangXuat" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-logout">
                <i class="bi bi-box-arrow-left"></i>
                <span>Đăng xuất</span>
            </button>
        </form>
    </div>

</aside>

<!-- ════════ TOPBAR ════════ -->
<header class="topbar">
    <div class="topbar-left">
        <button class="btn-sidebar-toggle" onclick="openSidebar()">
            <i class="bi bi-list fs-5"></i>
        </button>
        <span class="topbar-title">@ViewData["Title"]</span>
    </div>
    <div class="topbar-right">
        <span class="text-secondary small d-none d-md-inline">
            Xin chào, <strong>@ViewData["AdminName"]</strong>
        </span>
        <div class="topbar-avatar">
            <i class="bi bi-person-fill"></i>
        </div>
    </div>
</header>

<!-- ════════ CONTENT ════════ -->
<div class="main-wrap">
    <div class="content">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show
                        d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span>@TempData["Success"]</span>
                <button type="button" class="btn-close ms-auto"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show
                        d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-exclamation-circle-fill fs-5"></i>
                <span>@TempData["Error"]</span>
                <button type="button" class="btn-close ms-auto"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function openSidebar() {
        document.getElementById('sidebar').classList.add('open');
        document.getElementById('overlay').classList.add('open');
    }
    function closeSidebar() {
        document.getElementById('sidebar').classList.remove('open');
        document.getElementById('overlay').classList.remove('open');
    }
</script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>