@using bandothanhli.Areas.Admin.Models
@model DashboardVM
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<!-- THẺ THỐNG KÊ -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="stat-icon" style="background:#dbeafe">
                    <i class="bi bi-people" style="color:#1d4ed8"></i>
                </div>
                <span class="small text-success fw-semibold">
                    +@Model.NguoiDungMoiThangNay tháng này
                </span>
            </div>
            <div class="stat-value">@Model.TongNguoiDung</div>
            <div class="stat-label">Người dùng</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="stat-icon" style="background:#dcfce7">
                    <i class="bi bi-box-seam" style="color:#16a34a"></i>
                </div>
                <span class="small text-muted">@Model.SanPhamDangBan đang bán</span>
            </div>
            <div class="stat-value">@Model.TongSanPham</div>
            <div class="stat-label">Sản phẩm</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="stat-icon" style="background:#fef3c7">
                    <i class="bi bi-cart3" style="color:#d97706"></i>
                </div>
                @if (Model.DonChoPhanHoi > 0)
                {
                    <span class="badge bg-danger">@Model.DonChoPhanHoi mới</span>
                }
            </div>
            <div class="stat-value">@Model.TongDonHang</div>
            <div class="stat-label">Đơn hàng</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="stat-icon" style="background:#fce7f3">
                    <i class="bi bi-cash-stack" style="color:#be185d"></i>
                </div>
                @{
                    var diff = Model.DoanhThuThangNay - Model.DoanhThuThangTruoc;
                    var pct = Model.DoanhThuThangTruoc > 0
                        ? Math.Round((double)diff / (double)Model.DoanhThuThangTruoc * 100, 1) : 0;
                }
                <span class="small @(diff >= 0 ? "text-success" : "text-danger") fw-semibold">
                    <i class="bi bi-arrow-@(diff >= 0 ? "up" : "down")"></i>@Math.Abs(pct)%
                </span>
            </div>
            <div class="stat-value" style="font-size:1.35rem">
                @Model.DoanhThuHomNay.ToString("N0")đ
            </div>
            <div class="stat-label">Doanh thu hôm nay</div>
        </div>
    </div>
</div>

<!-- BIỂU ĐỒ + CẦN XỬ LÝ -->
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-graph-up me-2 text-primary"></i>Doanh thu 30 ngày qua</span>
                <span class="text-muted small">
                    Tháng này:
                    <strong class="text-dark">@Model.DoanhThuThangNay.ToString("N0")đ</strong>
                </span>
            </div>
            <div class="card-body">
                <canvas id="chartDoanhThu" height="110"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-clipboard-check me-2 text-warning"></i>Cần xử lý
            </div>
            <div class="card-body d-flex flex-column gap-2">
                <a asp-area="Admin" asp-controller="DonHang" asp-action="Index"
                       asp-route-trangThai="ChoPhanHoi"
                       class="d-flex justify-content-between align-items-center p-3 rounded text-decoration-none"
                       style="background:#fef3c7">
                    <div>
                        <div class="fw-semibold text-dark small">Đơn chờ phản hồi</div>
                        <div class="text-muted" style="font-size:.75rem">Cần xác nhận</div>
                    </div>
                    <span class="badge bg-warning text-dark fs-6">@Model.DonChoPhanHoi</span>
                </a>
                <a asp-area="Admin" asp-controller="DonHang" asp-action="Index"
                       asp-route-trangThai="DangGiao"
                       class="d-flex justify-content-between align-items-center p-3 rounded text-decoration-none"
                       style="background:#ede9fe">
                    <div>
                        <div class="fw-semibold text-dark small">Đang giao hàng</div>
                        <div class="text-muted" style="font-size:.75rem">Theo dõi vận chuyển</div>
                    </div>
                    <span class="badge fs-6" style="background:#6d28d9">@Model.DonDangGiao</span>
                </a>
                <div class="d-flex justify-content-between align-items-center p-3 rounded"
                     style="background:#fce7f3">
                    <div>
                        <div class="fw-semibold small">Tin nhắn chưa đọc</div>
                        <div class="text-muted" style="font-size:.75rem">Cần phản hồi</div>
                    </div>
                    <span class="badge bg-danger fs-6">@Model.TinNhanChuaDoc</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- BIỂU ĐỒ TRÒN + CỘT -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-pie-chart me-2 text-info"></i>Trạng thái đơn hàng
            </div>
            <div class="card-body">
                <canvas id="chartDonHang" height="160"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-bar-chart me-2 text-success"></i>Sản phẩm theo danh mục
            </div>
            <div class="card-body">
                <canvas id="chartDanhMuc" height="160"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ĐƠN HÀNG + SẢN PHẨM GẦN ĐÂY -->
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clock-history me-2"></i>Đơn hàng gần đây</span>
                <a asp-area="Admin" asp-controller="DonHang" asp-action="Index"
                   class="btn btn-sm btn-outline-primary">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Người mua</th>
                            <th>Tổng tiền</th>
                            <th>Thanh toán</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dh in Model.DonHangGanDay)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-semibold small">@dh.TenNguoiMua</div>
                                    <div class="text-muted" style="font-size:.73rem">
                                        @dh.NgayTao.ToString("dd/MM HH:mm")
                                    </div>
                                </td>
                                <td class="fw-semibold text-danger small">
                                    @dh.TongTien.ToString("N0")đ
                                </td>
                                <td>
                                    <span class="badge-tt tt-@dh.TrangThaiThanhToan">
                                        @(dh.TrangThaiThanhToan == "DaThanhToan" ? "Đã TT" : "Chưa TT")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge-tt tt-@dh.TrangThai">@dh.TrangThai</span>
                                </td>
                                <td>
                                    <a asp-area="Admin" asp-controller="DonHang"
                                           asp-action="ChiTiet" asp-route-id="@dh.Id"
                                           class="btn btn-sm btn-light btn-action">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-box me-2"></i>Sản phẩm mới đăng</span>
                <a asp-area="Admin" asp-controller="SanPham" asp-action="Index"
                   class="btn btn-sm btn-outline-primary">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                @foreach (var sp in Model.SanPhamGanDay)
                {
                    <div class="d-flex align-items-center gap-3 px-3 py-2 border-bottom">
                        <img src="@(sp.AnhDaiDien ?? "/images/no-image.png")"
                             style="width:42px;height:42px;object-fit:cover;
                        border-radius:8px;border:1px solid #e2e8f0;flex-shrink:0" />
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-semibold small text-truncate">@sp.TieuDe</div>
                            <div class="text-muted" style="font-size:.73rem">@sp.TenNguoiBan</div>
                        </div>
                        <div class="text-end flex-shrink-0">
                            <div class="fw-semibold text-danger small">@sp.Gia.ToString("N0")đ</div>
                            <span class="badge-tt tt-@sp.TrangThai" style="font-size:.7rem">
                                @sp.TrangThai
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        new Chart(document.getElementById('chartDoanhThu'), {
        type: 'line',
        data: {
        labels: [@Html.Raw(string.Join(",", Model.BieuDoDoanhThu.Select(x => $"\"{x.Ngay}\"")))],
        datasets: [{
        data: [@Html.Raw(string.Join(",", Model.BieuDoDoanhThu.Select(x => x.DoanhThu)))],
        borderColor: '#f97316', backgroundColor: 'rgba(249,115,22,.1)',
        fill: true, tension: 0.4, pointRadius: 3, pointBackgroundColor: '#f97316'
        }]
        },
        options: {
        responsive: true, plugins: { legend: { display: false } },
        scales: {
        y: { ticks: { callback: v => v.toLocaleString('vi') + 'đ' }, grid: { color: '#f1f5f9' } },
        x: { grid: { display: false } }
        }
        }
        });

        new Chart(document.getElementById('chartDonHang'), {
        type: 'doughnut',
        data: {
        labels: ['Chờ phản hồi','Đã xác nhận','Đang giao','Đã giao','Huỷ đơn'],
        datasets: [{
        data: [@Model.DonChoPhanHoi, @Model.DonDaXacNhan,
        @Model.DonDangGiao, @Model.DonDaGiao, @Model.DonHuyDon],
        backgroundColor: ['#fbbf24','#3b82f6','#8b5cf6','#22c55e','#ef4444'],
        borderWidth: 2, borderColor: '#fff'
        }]
        },
        options: { responsive: true, plugins: { legend: { position: 'bottom' } }, cutout: '65%' }
        });

        new Chart(document.getElementById('chartDanhMuc'), {
        type: 'bar',
        data: {
        labels: [@Html.Raw(string.Join(",", Model.SanPhamTheoLoai.Select(x => $"\"{x.TenDanhMuc}\"")))],
        datasets: [{
        label: 'Số SP',
        data: [@Html.Raw(string.Join(",", Model.SanPhamTheoLoai.Select(x => x.SoLuong)))],
        backgroundColor: 'rgba(249,115,22,.75)',
        borderColor: '#f97316', borderWidth: 1, borderRadius: 4
        }]
        },
        options: {
        responsive: true, plugins: { legend: { display: false } },
        scales: {
        y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
        x: { grid: { display: false } }
        }
        }
        });
    </script>
}