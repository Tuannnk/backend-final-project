@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - EcoShop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: radial-gradient(circle at 20% 0%, rgba(46, 125, 50, 0.16), transparent 35%), radial-gradient(circle at 80% 20%, rgba(46, 125, 50, 0.14), transparent 40%), #eaf6ee; }
        .auth-card {
            max-width: 440px;
            margin: 80px auto;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 16px rgba(0,0,0,0.08);
            padding: 40px;
        }
        .btn-primary { background: #2e7d32; border: none; }
        .btn-primary:hover { background: #1b5e20; }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="text-center mb-4">
            <h4 class="fw-bold">🌿 EcoShop</h4>
            <p class="text-muted">Đăng nhập để tiếp tục</p>
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" id="email" class="form-control" placeholder="example@gmail.com">
            <div class="invalid-feedback" id="emailError"></div>
        </div>
        <div class="mb-3">
            <label class="form-label">Mật khẩu</label>
            <div class="input-group">
                <input type="password" id="matKhau" class="form-control" placeholder="Nhập mật khẩu">
                <button class="btn btn-outline-secondary" onclick="toggleMatKhau()" type="button">👁</button>
            </div>
            <div class="invalid-feedback d-block" id="matKhauError" style="display:none;"></div>
        </div>
        <div class="text-end mb-3">
            <a href="/auth/quen-mat-khau" class="text-muted small">Quên mật khẩu?</a>
        </div>

        <div id="errorDangNhap" class="text-danger mb-2" style="display:none;"></div>
        <button class="btn btn-primary w-100" onclick="dangNhap()">Đăng nhập</button>

        <p class="text-center mt-3 mb-0">
            Chưa có tài khoản? <a href="/auth/dang-ky">Đăng ký ngay</a>
        </p>
    </div>

    <script>
        function setFieldError(inputId, errorId, message) {
            const input = document.getElementById(inputId);
            const err = document.getElementById(errorId);
            if (!input || !err) return;

            if (message) {
                input.classList.add('is-invalid');
                err.textContent = message;
                err.style.display = 'block';
            } else {
                input.classList.remove('is-invalid');
                err.textContent = '';
                err.style.display = 'none';
            }
        }

        function clearErrors() {
            setFieldError('email', 'emailError', '');
            setFieldError('matKhau', 'matKhauError', '');
            const errorEl = document.getElementById('errorDangNhap');
            if (errorEl) {
                errorEl.textContent = '';
                errorEl.style.display = 'none';
            }
        }

        function isValidEmail(email) {
            return /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(String(email || '').trim());
        }

        function toggleMatKhau() {
            const input = document.getElementById('matKhau');
            input.type = input.type === 'password' ? 'text' : 'password';
        }

        async function dangNhap() {
            clearErrors();

            const email = document.getElementById('email').value.trim();
            const matKhau = document.getElementById('matKhau').value;
            const errorEl = document.getElementById('errorDangNhap');

            let ok = true;
            if (!email) {
                setFieldError('email', 'emailError', 'Email là bắt buộc');
                ok = false;
            } else if (!isValidEmail(email)) {
                setFieldError('email', 'emailError', 'Email không hợp lệ');
                ok = false;
            }

            if (!matKhau) {
                setFieldError('matKhau', 'matKhauError', 'Mật khẩu là bắt buộc');
                ok = false;
            }

            if (!ok) return;

            try {
                const res = await fetch('/api/auth/dang-nhap', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, matKhau })
                });

                let data = null;
                try {
                    data = await res.json();
                } catch {}

                if (res.ok) {
                    localStorage.setItem('token', data.token);
                    localStorage.setItem('nguoiDung', JSON.stringify(data.nguoiDung));

                    // Chuyển hướng theo vai trò
                    if (data.nguoiDung.vaiTro === 'admin') {
                        window.location.href = '/admin/dashboard';
                    } else {
                        window.location.href = '/';
                    }
                } else {
                    const errors = data && data.errors ? data.errors : null;
                    if (errors) {
                        const emailMsg = (errors.Email && errors.Email[0]) || '';
                        const passMsg = (errors.MatKhau && errors.MatKhau[0]) || '';
                        if (emailMsg) setFieldError('email', 'emailError', emailMsg);
                        if (passMsg) setFieldError('matKhau', 'matKhauError', passMsg);
                    }

                    if (errorEl) {
                        errorEl.textContent = (data && data.message) ? data.message : 'Đăng nhập thất bại';
                        errorEl.style.display = 'block';
                    }
                }
            } catch (e) {
                errorEl.textContent = 'Lỗi kết nối server';
                errorEl.style.display = 'block';
            }
        }

        // Cho phép nhấn Enter để đăng nhập
        document.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') dangNhap();
        });

        document.getElementById('email')?.addEventListener('input', () => setFieldError('email', 'emailError', ''));
        document.getElementById('matKhau')?.addEventListener('input', () => setFieldError('matKhau', 'matKhauError', ''));
    </script>
</body>
</html>
