@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký - EcoShop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
            body { background: radial-gradient(circle at 20% 0%, rgba(46, 125, 50, 0.16), transparent 35%), radial-gradient(circle at 80% 20%, rgba(46, 125, 50, 0.14), transparent 40%), #eaf6ee; }
            .auth-card {
                max-width: 480px;
                margin: 60px auto;
                background: #fff;
                border-radius: 12px;
                box-shadow: 0 2px 16px rgba(0,0,0,0.08);
                padding: 40px;
            }
            .btn-primary { background: #2e7d32; border: none; }
            .btn-primary:hover { background: #1b5e20; }
            .otp-box { display: none; }
            .otp-input {
                letter-spacing: 12px;
                font-size: 24px;
                text-align: center;
            }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="text-center mb-4">
            <h4 class="fw-bold">🌿 EcoShop</h4>
            <p class="text-muted">Tạo tài khoản mới</p>
        </div>

        <!-- Form đăng ký -->
        <div id="formDangKy">
            <div class="mb-3">
                <label class="form-label">Họ tên</label>
                <input type="text" id="hoTen" class="form-control" placeholder="Nguyễn Văn A">
                <div class="invalid-feedback" id="hoTenError"></div>
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" id="email" class="form-control" placeholder="example@gmail.com">
                <div class="invalid-feedback" id="emailError"></div>
            </div>
            <div class="mb-3">
                <label class="form-label">Số điện thoại</label>
                <input type="text" id="soDienThoai" class="form-control" placeholder="0901234567">
                <div class="invalid-feedback" id="soDienThoaiError"></div>
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu</label>
                <input type="password" id="matKhau" class="form-control" placeholder="Ít nhất 6 ký tự">
                <div class="invalid-feedback" id="matKhauError"></div>
            </div>
            <div id="errorDangKy" class="text-danger mb-2" style="display:none;"></div>
            <button class="btn btn-primary w-100" onclick="dangKy()">Đăng ký</button>
            <p class="text-center mt-3 mb-0">
                Đã có tài khoản? <a href="/auth/dang-nhap">Đăng nhập</a>
            </p>
        </div>

        <!-- Form nhập OTP -->
        <div id="formOtp" class="otp-box">
            <div class="text-center mb-4">
                <div style="font-size: 48px;">📧</div>
                <h5 class="fw-bold">Xác minh email</h5>
                <p class="text-muted">Mã OTP đã được gửi đến <b id="emailHienThi"></b></p>
            </div>
            <div class="mb-3">
                <input type="text" id="maOtp" class="form-control otp-input" maxlength="6" placeholder="000000">
            </div>
            <div id="errorOtp" class="text-danger mb-2" style="display:none;"></div>
            <button class="btn btn-primary w-100" onclick="xacMinhOtp()">Xác minh</button>
            <div class="text-center mt-3">
                <span class="text-muted">Không nhận được mã? </span>
                <a href="#" onclick="guiLaiOtp()">Gửi lại</a>
            </div>
        </div>

        <!-- Thành công -->
        <div id="thanhCong" style="display:none; text-align:center;">
            <div style="font-size: 64px;">✅</div>
            <h5 class="fw-bold mt-3">Đăng ký thành công!</h5>
            <p class="text-muted">Tài khoản của bạn đã được xác minh.</p>
            <a href="/auth/dang-nhap" class="btn btn-primary w-100">Đăng nhập ngay</a>
        </div>
    </div>

    <script>
            let emailDangKy = '';

            function setFieldError(inputId, errorId, message) {
                const input = document.getElementById(inputId);
                const err = document.getElementById(errorId);
                if (!input || !err) return;

                if (message) {
                    input.classList.add('is-invalid');
                    err.textContent = message;
                } else {
                    input.classList.remove('is-invalid');
                    err.textContent = '';
                }
            }

            function clearErrors() {
                setFieldError('hoTen', 'hoTenError', '');
                setFieldError('email', 'emailError', '');
                setFieldError('soDienThoai', 'soDienThoaiError', '');
                setFieldError('matKhau', 'matKhauError', '');
                const errorEl = document.getElementById('errorDangKy');
                if (errorEl) {
                    errorEl.textContent = '';
                    errorEl.style.display = 'none';
                }
            }

            function isValidEmail(email) {
                return /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(String(email || '').trim());
            }

            function isValidPhone(phone) {
                return /^0\d{9,10}$/.test(String(phone || '').trim());
            }

            function isValidPassword(pw) {
                const s = String(pw || '');
                if (s.length < 6) return false;
                return /[A-Za-z]/.test(s) && /\d/.test(s);
            }

            async function dangKy() {
                clearErrors();

                const hoTen = document.getElementById('hoTen').value.trim();
                const email = document.getElementById('email').value.trim();
                const soDienThoai = document.getElementById('soDienThoai').value.trim();
                const matKhau = document.getElementById('matKhau').value;
                const errorEl = document.getElementById('errorDangKy');

                let ok = true;
                if (!hoTen) {
                    setFieldError('hoTen', 'hoTenError', 'Họ tên là bắt buộc');
                    ok = false;
                } else if (hoTen.length < 2) {
                    setFieldError('hoTen', 'hoTenError', 'Họ tên tối thiểu 2 ký tự');
                    ok = false;
                }

                if (!email) {
                    setFieldError('email', 'emailError', 'Email là bắt buộc');
                    ok = false;
                } else if (!isValidEmail(email)) {
                    setFieldError('email', 'emailError', 'Email không hợp lệ');
                    ok = false;
                }

                if (!soDienThoai) {
                    setFieldError('soDienThoai', 'soDienThoaiError', 'Số điện thoại là bắt buộc');
                    ok = false;
                } else if (!isValidPhone(soDienThoai)) {
                    setFieldError('soDienThoai', 'soDienThoaiError', 'Số điện thoại không hợp lệ (vd: 0901234567)');
                    ok = false;
                }

                if (!matKhau) {
                    setFieldError('matKhau', 'matKhauError', 'Mật khẩu là bắt buộc');
                    ok = false;
                } else if (!isValidPassword(matKhau)) {
                    setFieldError('matKhau', 'matKhauError', 'Mật khẩu tối thiểu 6 ký tự và phải có ít nhất 1 chữ + 1 số');
                    ok = false;
                }

                if (!ok) return;

                try {
                    const res = await fetch('/api/auth/dang-ky', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ hoTen, email, soDienThoai, matKhau })
                    });

                    let data = null;
                    try {
                        data = await res.json();
                    } catch {}

                    if (res.ok) {
                        emailDangKy = email;
                        document.getElementById('emailHienThi').textContent = email;
                        document.getElementById('formDangKy').style.display = 'none';
                        document.getElementById('formOtp').style.display = 'block';
                    } else {
                        const errors = data && data.errors ? data.errors : null;
                        if (errors) {
                            const hoTenMsg = (errors.HoTen && errors.HoTen[0]) || '';
                            const emailMsg = (errors.Email && errors.Email[0]) || '';
                            const phoneMsg = (errors.SoDienThoai && errors.SoDienThoai[0]) || '';
                            const passMsg = (errors.MatKhau && errors.MatKhau[0]) || '';
                            if (hoTenMsg) setFieldError('hoTen', 'hoTenError', hoTenMsg);
                            if (emailMsg) setFieldError('email', 'emailError', emailMsg);
                            if (phoneMsg) setFieldError('soDienThoai', 'soDienThoaiError', phoneMsg);
                            if (passMsg) setFieldError('matKhau', 'matKhauError', passMsg);
                        }

                        errorEl.textContent = (data && data.message) ? data.message : 'Đăng ký thất bại';
                        errorEl.style.display = 'block';
                    }
                } catch (e) {
                    errorEl.textContent = 'Lỗi kết nối server';
                    errorEl.style.display = 'block';
                }
            }

            async function xacMinhOtp() {
                const maOtp = document.getElementById('maOtp').value;
                const errorEl = document.getElementById('errorOtp');

                if (maOtp.length !== 6) {
                    errorEl.textContent = 'Vui lòng nhập đủ 6 số';
                    errorEl.style.display = 'block';
                    return;
                }

                try {
                    const res = await fetch('/api/auth/xac-minh-otp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email: emailDangKy, maOtp })
                    });

                    const data = await res.json();

                    if (res.ok) {
                        document.getElementById('formOtp').style.display = 'none';
                        document.getElementById('thanhCong').style.display = 'block';
                    } else {
                        errorEl.textContent = data.message;
                        errorEl.style.display = 'block';
                    }
                } catch (e) {
                    errorEl.textContent = 'Lỗi kết nối server';
                    errorEl.style.display = 'block';
                }
            }

            async function guiLaiOtp() {
                await fetch('/api/auth/dang-ky', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: emailDangKy })
                });
                alert('Đã gửi lại mã OTP!');
            }

            document.getElementById('hoTen')?.addEventListener('input', () => setFieldError('hoTen', 'hoTenError', ''));
            document.getElementById('email')?.addEventListener('input', () => setFieldError('email', 'emailError', ''));
            document.getElementById('soDienThoai')?.addEventListener('input', () => setFieldError('soDienThoai', 'soDienThoaiError', ''));
            document.getElementById('matKhau')?.addEventListener('input', () => setFieldError('matKhau', 'matKhauError', ''));
    </script>
</body>
</html>
